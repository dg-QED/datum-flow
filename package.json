{
  "name": "datum-flow",
  "version": "1.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Datum Flow — browser-based crowd, egress and pedestrian-movement simulation (Datum suite, QED Architecture & Engineering)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "esbuild tests/model.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/flow-tests.mjs --log-level=warning && node node_modules/.cache/flow-tests.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:ai": "node tests/e2e-ai.mjs"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "playwright": "1.56.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.3.0",
    "ws": "^8.18.3"
  }
}
